#!/usr/bin/env python3
"""Add an Arsenal men's match and download its Cannon Stats images.

Reads and writes data/matches.json. Originals land in public/images/ and
~400px-wide WebP thumbnails land in public/thumbs/.

An optional "report" field copies a Markdown file into
data/reports/<date>_<opponent-slug>.md and stores that filename on the match.
The site shows a circular R on that fixture only when the field is set.
Write an approximate substitution minute as ~65'. Omit the minute when it is unknown.

Usage:
  scripts/add-match path/to/match.json   Add one match, then download images
  scripts/add-match --fetch              Download anything listed but missing

Women's matches are refused. Image URLs are rewritten to pbs.twimg name=orig.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from urllib.parse import parse_qs, urlencode, urlparse, urlunparse

ROOT = Path(__file__).resolve().parents[1]
DATA_PATH = ROOT / "data" / "matches.json"
REPORTS_DIR = ROOT / "data" / "reports"
IMAGE_DIR = ROOT / "public" / "images"
THUMB_DIR = ROOT / "public" / "thumbs"
META_PATH = ROOT / "data" / "image-meta.json"
REPORT_NAME = re.compile(r"^\d{4}-\d{2}-\d{2}_[a-z0-9]+(?:-[a-z0-9]+)*\.md$")

THUMB_WIDTH = 400
USER_AGENT = "ArsenalStatsImageFetcher/1.0"
ALLOWED_COMPETITIONS = {
    "Community Shield",
    "Premier League",
    "Champions League",
    "League Cup",
}


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def load_db() -> dict:
    if not DATA_PATH.exists():
        return {
            "source": "@scottjwillis (Cannon Stats) post-match posts on X",
            "season": "2026-27",
            "generated": "",
            "note": "Team stats transcribed from the Full Time card where available; null = not transcribed.",
            "matches": [],
        }
    with DATA_PATH.open(encoding="utf-8") as handle:
        return json.load(handle)


def save_db(db: dict) -> None:
    DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
    with DATA_PATH.open("w", encoding="utf-8") as handle:
        json.dump(db, handle, indent=1, ensure_ascii=False)
        handle.write("\n")


def https_url(url: str, label: str) -> str:
    parsed = urlparse(url.strip())
    if parsed.scheme != "https" or not parsed.netloc:
        die(f"{label} must be an https URL")
    return url.strip()


def orig_url(url: str) -> str:
    parsed = urlparse(url.strip())
    if parsed.netloc not in {"pbs.twimg.com", "ton.twimg.com"}:
        die(f"image host must be pbs.twimg.com, got {parsed.netloc or url}")
    query = {key: values[-1] for key, values in parse_qs(parsed.query).items()}
    query["name"] = "orig"
    query.setdefault("format", "jpg")
    return urlunparse(parsed._replace(query=urlencode(query), fragment=""))


def assert_mens(match: dict) -> None:
    team = str(match.get("team") or "Men").strip()
    if team.lower() not in {"men", "mens", "men's"}:
        die(f"refusing non-men's match (team={team!r}). Women's matches are out of scope.")
    blob = json.dumps(match, ensure_ascii=False).lower()
    for banned in ("women", "woman", "wsl", "arsenal wfc"):
        if banned in blob:
            die("refusing match that looks like a women's fixture")
    match["team"] = "Men"


def opponent_slug(name: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if not slug:
        die("could not build a report filename from the opponent")
    return slug


def canonical_report_name(match: dict) -> str:
    filename = f"{match['date']}_{opponent_slug(match['opponent'])}.md"
    if not REPORT_NAME.match(filename):
        die(f"unsafe report filename {filename}")
    return filename


def resolve_report_source(report: str, match_json: Path) -> Path:
    raw_path = Path(report.strip())
    candidates = [raw_path] if raw_path.is_absolute() else [
        match_json.parent / raw_path,
        ROOT / raw_path,
        REPORTS_DIR / raw_path.name,
    ]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    die(
        "report file not found: "
        f"{report}. Put the markdown next to the match JSON, or in data/reports/."
    )


def attach_report(raw: dict, match: dict, match_json: Path) -> None:
    """Copy an optional match report into data/reports and record its filename."""
    report = raw.get("report")
    if report is None or report == "":
        return
    if not isinstance(report, str):
        die("report must be a path to a markdown file, or a filename in data/reports")
    source = resolve_report_source(report, match_json)
    if source.suffix.lower() != ".md":
        die("report must be a .md file")
    text = source.read_text(encoding="utf-8")
    if not text.strip():
        die("report file is empty")
    lowered = text.lower()
    for banned in ("women", "woman", "wsl", "arsenal wfc"):
        if banned in lowered:
            die("refusing a report that looks like a women's match")
    filename = canonical_report_name(match)
    dest = REPORTS_DIR / filename
    dest.parent.mkdir(parents=True, exist_ok=True)
    if source.resolve() != dest.resolve():
        dest.write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
    match["report"] = filename


def normalize_match(raw: dict) -> dict:
    if not isinstance(raw, dict):
        die("match file must be a JSON object")
    assert_mens(raw)
    required = ["date", "competition", "opponent", "venue", "score", "posts"]
    missing = [key for key in required if not raw.get(key)]
    if missing:
        die(f"match is missing {', '.join(missing)}")
    venue = str(raw["venue"]).strip().upper()
    if venue not in {"H", "A"}:
        die("venue must be H or A")
    score = str(raw["score"]).replace("–", "-").replace("—", "-").replace(" ", "")
    parts = score.split("-")
    if len(parts) != 2 or not all(part.isdigit() for part in parts):
        die(f"score must look like 2-1, got {raw['score']!r}")
    opponent = str(raw["opponent"]).strip()
    home = str(raw.get("home") or ("Arsenal" if venue == "H" else opponent)).strip()
    away = str(raw.get("away") or ("Arsenal" if venue == "A" else opponent)).strip()
    if venue == "H" and home != "Arsenal":
        die("home match must have home=Arsenal")
    if venue == "A" and away != "Arsenal":
        die("away match must have away=Arsenal")
    competition = str(raw["competition"]).strip()
    if competition not in ALLOWED_COMPETITIONS:
        die(
            "competition must be one of: " + ", ".join(sorted(ALLOWED_COMPETITIONS))
        )
    posts = []
    seen_files = set()
    for index, post in enumerate(raw["posts"], start=1):
        if not isinstance(post, dict) or not post.get("url") or not post.get("images"):
            die(f"post {index} needs url and images")
        images = []
        for image in post["images"]:
            if not isinstance(image, dict) or not image.get("file") or not image.get("url"):
                die(f"post {index} has an image without file and url")
            filename = Path(str(image["file"])).name
            if filename != str(image["file"]) or ".." in filename or filename in {"", ".", ".."}:
                die(f"unsafe image filename {image['file']!r}")
            if filename in seen_files:
                die(f"duplicate image filename {filename}")
            seen_files.add(filename)
            images.append({"file": filename, "url": orig_url(str(image["url"]))})
        posts.append(
            {
                "url": https_url(str(post["url"]), f"post {index}"),
                "title": str(post.get("title") or "").strip(),
                "posted_utc": post.get("posted_utc") or "",
                "images": images,
            }
        )
    xg = raw.get("xg")
    if xg is not None:
        xg = str(xg).replace("–", "-").replace(" ", "")
    image_count = sum(len(post["images"]) for post in posts)
    return {
        "date": str(raw["date"]).strip(),
        "competition": competition,
        "team": "Men",
        "home": home,
        "away": away,
        "opponent": opponent,
        "venue": venue,
        "score": score,
        "xg": xg,
        "image_count": image_count,
        "team_stats": raw.get("team_stats"),
        "full_time_post": raw.get("full_time_post") or posts[0]["url"],
        "posts": posts,
    }


def iter_images(db: dict):
    seen = set()
    for match in db.get("matches", []):
        assert_mens(match)
        for post in match.get("posts", []):
            for image in post.get("images", []):
                filename = Path(image["file"]).name
                if filename in seen:
                    die(f"duplicate image filename {filename}")
                seen.add(filename)
                yield filename, orig_url(image["url"])


def download(url: str, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_suffix(dest.suffix + ".part")
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    last_error = None
    for _ in range(4):
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                data = response.read()
            if len(data) < 1000 or not data.startswith(b"\xff\xd8"):
                raise RuntimeError(f"not a jpeg ({len(data)} bytes)")
            tmp.write_bytes(data)
            tmp.replace(dest)
            return
        except (urllib.error.URLError, TimeoutError, RuntimeError, OSError) as error:
            last_error = error
    raise RuntimeError(f"{url} -> {last_error}")


def make_thumb(src: Path, dest: Path) -> dict:
    from PIL import Image

    dest.parent.mkdir(parents=True, exist_ok=True)
    with Image.open(src) as image:
        image = image.convert("RGB")
        width, height = image.size
        if width > THUMB_WIDTH:
            thumb_height = max(1, round(height * (THUMB_WIDTH / width)))
            image = image.resize((THUMB_WIDTH, thumb_height), Image.Resampling.LANCZOS)
        image.save(dest, format="WEBP", quality=76, method=4)
        return {"w": width, "h": height}


def fetch_missing(db: dict) -> None:
    try:
        from PIL import Image  # noqa: F401
    except ImportError:
        die("Pillow is required. Run: pip install -r requirements.txt")

    jobs = []
    for filename, url in iter_images(db):
        original = IMAGE_DIR / filename
        thumb = THUMB_DIR / (Path(filename).stem + ".webp")
        if not original.exists() or not thumb.exists():
            jobs.append((filename, url, original, thumb))
    if not jobs:
        print(f"images already present ({sum(1 for _ in iter_images(db))} files)")
    else:
        print(f"fetching {len(jobs)} image(s)")

        def task(item):
            filename, url, original, thumb = item
            if not original.exists():
                download(url, original)
            meta = make_thumb(original, thumb)
            return filename, meta

        done = 0
        meta = {}
        if META_PATH.exists():
            meta = json.loads(META_PATH.read_text(encoding="utf-8"))
        with ThreadPoolExecutor(max_workers=8) as pool:
            futures = {pool.submit(task, item): item[0] for item in jobs}
            for future in as_completed(futures):
                filename = futures[future]
                name, info = future.result()
                meta[name] = info
                done += 1
                if done % 20 == 0 or done == len(jobs):
                    print(f"  {done}/{len(jobs)} {filename}")
        META_PATH.write_text(json.dumps(meta, indent=1) + "\n", encoding="utf-8")

    # Refresh dimensions for every file so a partial meta file cannot drift.
    from PIL import Image

    meta = {}
    for filename, _url in iter_images(db):
        original = IMAGE_DIR / filename
        thumb = THUMB_DIR / (Path(filename).stem + ".webp")
        if not original.exists() or not thumb.exists():
            die(f"missing files for {filename}")
        with Image.open(original) as image:
            meta[filename] = {"w": image.size[0], "h": image.size[1]}
    META_PATH.write_text(json.dumps(meta, indent=1) + "\n", encoding="utf-8")
    print(f"ready: {len(meta)} originals in public/images, thumbs in public/thumbs")


def add_match(path: Path) -> None:
    raw = json.loads(path.read_text(encoding="utf-8"))
    match = normalize_match(raw)
    attach_report(raw, match, path)
    db = load_db()
    dates = [existing["date"] for existing in db.get("matches", [])]
    if match["date"] in dates:
        die(f"a match on {match['date']} is already in data/matches.json")
    filenames = {name for name, _url in iter_images(db)}
    for post in match["posts"]:
        for image in post["images"]:
            if image["file"] in filenames:
                die(f"image filename already used: {image['file']}")
    db.setdefault("matches", []).append(match)
    db["matches"].sort(key=lambda item: item["date"], reverse=True)
    save_db(db)
    print(
        f"added {match['date']} {match['competition']} vs {match['opponent']} "
        f"({match['image_count']} images)"
    )
    fetch_missing(db)


def main() -> None:
    parser = argparse.ArgumentParser(description="Add an Arsenal men's Cannon Stats match")
    parser.add_argument("match_json", nargs="?", help="Path to a single match JSON object")
    parser.add_argument(
        "--fetch",
        action="store_true",
        help="Download missing originals and thumbnails for matches already in the data file",
    )
    args = parser.parse_args()
    if args.fetch and args.match_json:
        die("pass either a match file or --fetch, not both")
    if args.fetch:
        fetch_missing(load_db())
        return
    if not args.match_json:
        parser.print_help()
        die("provide a match JSON file, or --fetch")
    add_match(Path(args.match_json))


if __name__ == "__main__":
    main()
